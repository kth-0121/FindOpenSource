# GitHub Sponsors URL for the Support CTA (Header, Footer, Homepage, About,
# and /support). Replace YOUR_GITHUB_USERNAME with the real GitHub Sponsors
# page. Leave this unset (or keep the placeholder) to hide the Support CTA
# without breaking the dev server or the production build.
NEXT_PUBLIC_SUPPORT_URL=https://github.com/sponsors/YOUR_GITHUB_USERNAME

# Google Analytics 4 measurement ID (starts with "G-"). Loaded via the
# official @next/third-parties/google <GoogleAnalytics> component in
# app/[locale]/layout.tsx. Leave unset to disable GA entirely (no script is
# rendered at all when this is empty).
NEXT_PUBLIC_GA_ID=

# AI-assisted search query understanding (see docs/ai-search.md). An
# enhancement only -- search works fully with all of these unset/false.
# Server-side gate. Must be "true" AND AI_QUERY_ENDPOINT AND AI_QUERY_MODEL
# set for the AI layer to ever be called.
AI_QUERY_ENABLED=false
# An OpenAI-compatible `/v1/chat/completions` endpoint -- e.g. a local
# OmniRoute instance (http://localhost:20128/v1/chat/completions) or any
# other OpenAI-compatible gateway. FindOSS builds the system prompt itself
# (lib/ai/prompt.ts) and sends it with every request -- the gateway only
# needs to route to a real model, not know anything about FindOSS.
AI_QUERY_ENDPOINT=
# Model id as the gateway expects it (e.g. "gemini/gemini-3.1-flash-lite"
# for an OmniRoute-routed Gemini connection). Required whenever
# AI_QUERY_ENABLED=true. Never "auto" or any other auto-routing alias --
# auto-routing on a multi-provider gateway can silently fall back to
# untrusted/ToS-risky free providers (see docs/ai-search.md#model-selection).
AI_QUERY_MODEL=
# Optional bearer token sent as `Authorization: Bearer <token>` to
# AI_QUERY_ENDPOINT (e.g. an OmniRoute API key, scoped, admin access off).
# Never exposed to the browser.
AI_QUERY_ENDPOINT_TOKEN=
# Max time (ms) to wait for AI_QUERY_ENDPOINT before falling back to plain
# keyword search. Keep short -- AI must never make search feel slow.
AI_QUERY_TIMEOUT_MS=1500
# Server-side cache TTL (seconds) for AI query-understanding results.
AI_QUERY_CACHE_TTL=86400
# Client-side mirror of AI_QUERY_ENABLED: gates whether the browser bothers
# calling /api/search/understand at all. Keep in sync with AI_QUERY_ENABLED
# manually -- the server independently re-checks AI_QUERY_ENABLED either
# way, so a mismatch only wastes/saves one harmless request, never a
# security concern.
NEXT_PUBLIC_AI_QUERY_ENABLED=false
